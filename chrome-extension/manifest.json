{
  "manifest_version": 3,
  "name": "ReceiptWise Clipper",
  "version": "1.1.0",
  "description": "Clip a receipt or bill from any web page into ReceiptWise, where it's read and filed for you.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Clip a receipt",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.receiptwise.io/*"
  ],
  "externally_connectable": {
    "matches": ["https://www.receiptwise.io/*"]
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "capture-receipt": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Clip a receipt or bill from this page"
    }
  }
}
