{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "lhr1"
  ],
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)mobile'",
  "crons": [
    {
      "path": "/api/cron/sweep-receipts",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/process-deletions",
      "schedule": "6 * * * *"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/reconcile-store-premium",
      "schedule": "8 * * * *"
    },
    {
      "path": "/api/cron/bills-daily",
      "schedule": "9 2 * * *"
    },
    {
      "path": "/api/cron/stripe-resync",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/cron/growth-report",
      "schedule": "20 8 * * 1"
    }
  ]
}
