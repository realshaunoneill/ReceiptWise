# Copy to .env.local and fill in. Never commit real values.
# Vercel holds the deployed values per environment (Production / Preview / Development).

# Database (Neon Postgres). drizzle.config.ts and lib/db read DATABASE_URL.
DATABASE_URL=

# Sign-in (Better Auth, lib/auth.ts). BETTER_AUTH_SECRET signs sessions: `openssl rand -base64 32`.
# BETTER_AUTH_URL is where Google returns to; locally http://localhost:3000. The Google OAuth client
# needs <BETTER_AUTH_URL>/api/auth/callback/google as an authorised redirect URI.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local only: an email/password sign-in for testing without Google. Refused on Vercel.
# RECEIPTWISE_DEV_LOGIN=1

# Stripe (test keys locally). STRIPE_WEBHOOK_SECRET must be the signing secret of the webhook
# endpoint for the *same* Stripe mode as STRIPE_SECRET_KEY — a test-mode secret in production
# makes every live webhook fail verification.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
# Free-trial length for first-time subscribers; unset or 0 disables the trial everywhere.
NEXT_PUBLIC_STRIPE_TRIAL_DAYS=14

# Absolute origin for links. Production ignores this and uses https://www.receiptwise.io
# (see lib/app-url.ts); locally set it to your dev server.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bearer token Vercel Cron sends to /api/cron/*. The cron routes fail closed without it.
CRON_SECRET=

# AI (receipts, bills, spending summaries) through the Vercel AI Gateway: lib/ai-model.ts picks the
# models. On Vercel the deployment's OIDC token also works; locally set a gateway key.
AI_GATEWAY_API_KEY=
# Optional overrides, e.g. google/gemini-2.5-flash. Compare with scripts/model-bakeoff.ts first.
# RECEIPTWISE_RECEIPT_MODEL=
# RECEIPTWISE_BILL_MODEL=
# RECEIPTWISE_SUMMARY_MODEL=

# Vercel Blob (receipt images)
BLOB_READ_WRITE_TOKEN=

# PostHog (EU). Analytics only initialise after the visitor accepts the consent banner.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Rapid7 InsightOps log shipping (lib/logging.ts)
LOG_TOKEN=
LOG_REGION=eu

# Shows the staging banner
NEXT_PUBLIC_IS_STAGING=
# Upload size limit in MB for the web upload route (optional)
NEXT_PUBLIC_MAX_UPLOAD_MB=

# In-app purchase (the app's Premium through the App Store and Google Play), via RevenueCat. Unset,
# the webhook and sync answer 503 and the hourly reconcile does nothing (lib/revenuecat.ts).
# The project's secret API key (v1), and the exact Authorization header the webhook is set to send.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=

# The app's push notifications (lib/push): sent through Expo's push service, which holds the APNs
# key and FCM credentials on EAS. EXPO_ACCESS_TOKEN only if the Expo project turns on enhanced push
# security; PUSH_DISABLED=1 stops all sending.
EXPO_ACCESS_TOKEN=
PUSH_DISABLED=
