{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "e2e": {
      "distribution": "internal",
      "channel": "e2e",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://staging.receiptwise.io",
        "EXPO_PUBLIC_DEV_LOGIN": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6828428892"
      }
    }
  }
}
